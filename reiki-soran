const KN="〇一二三四五六七八九十百千";
const ART_RE=new RegExp("第["+KN+"]+条(?:の["+KN+"]+)*","g");
const LREF_RE=new RegExp("(?:明治|大正|昭和|平成|令和)(?:元|["+KN+"]+)年[^\\s（）()、。「」第]{1,20}第["+KN+"]+号","g");
function decorate(text,toks){
  // 法令番号→リンク、条番号→ページ内リンク。検索語はハイライト
  let out="",last=0,m; LREF_RE.lastIndex=0;
  const part=seg=>{
    let r="",p=0,mm; ART_RE.lastIndex=0;
    while((mm=ART_RE.exec(seg))){ r+=hlLite(seg.slice(p,mm.index),toks)+`<a class="xref" data-art="${esc(mm[0])}">${hlLite(mm[0],toks)}</a>`; p=mm.index+mm[0].length; }
    return r+hlLite(seg.slice(p),toks);
  };
  while((m=LREF_RE.exec(text))){
    out+=part(text.slice(last,m.index));
    const j=numMap.get(m[0]);
    out+= j!=null?`<a class="lref" href="#/law/${esc(L[j][I.ID])}" title="${esc(L[j][I.TITLE])}">${esc(m[0])}</a>`:esc(m[0]);
    last=m.index+m[0].length;
  }
  return out+part(text.slice(last));
}
function hlLite(s,toks){
  if(!toks.length) return esc(s);
  const n=norm(s); if(n.length!==s.length) return esc(s);
  const mk=new Array(s.length).fill(false);
  toks.forEach(t=>{let p=0;while((p=n.indexOf(t,p))>=0){for(let k=0;k<t.length;k++)mk[p+k]=true;p+=t.length;}});
  let r="",o=false; for(let k=0;k<s.length;k++){ if(mk[k]&&!o){r+="<mark>";o=true;} if(!mk[k]&&o){r+="</mark>";o=false;} r+=esc(s[k]); }
  return r+(o?"</mark>":"");
}
