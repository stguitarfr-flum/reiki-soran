  CURKEY=null;
  $("#main").innerHTML=`<div class="dhead"><div class="eyebrow"><span class="badge b-kind">Guide</span></div><h2>使い方・運用の手引き</h2></div><div class="pane">
  <div class="sec-h">基本操作</div>
