/* ======================= マイ登録 ======================= */
function showMine(qs){
  const p=new URLSearchParams(qs||""); let ed=null;
  if(p.get("edit")) ed=U.docs.find(d=>d.id===p.get("edit"));
  if(p.get("copy")){ const s=docById(p.get("copy")); if(s) ed=Object.assign({},s,{id:"",title:s.title+"（コピー）",user:true,sample:false,related:(s.related||[]).slice()}); }
  const d=ed||{level:"町",kind:"要綱",title:"",issuer:SET.town||"",number:"",url:"",summary:"",tags:[]};
  const list=U.docs.map(x=>`<a class="rel-item" href="#/doc/${esc(x.id)}">${levelBadge(x.level)}${clsBadge(x.kind)}<span class="rt">${esc(x.title)}</span><span class="rn"><button class="rm" data-deldoc="${esc(x.id)}">削除</button></span></a>`).join("")||`<div class="empty">まだ登録がありません</div>`;
  $("#main").innerHTML=`<div class="dhead"><div class="eyebrow"><span class="badge b-fill">マイ登録</span></div><h2>例規・指針の追加／バックアップ</h2>
    <p style="color:var(--muted);margin:6px 0 0">町・県の条例、規則、要綱、通達などを自分で登録できます。登録後は各法令画面の「＋関連づけを追加」で法令どうしを結べます。</p></div>
  <div class="pane">
    <div class="sec-h">${ed&&ed.id?"登録内容の編集":"新規登録"}</div>
    <form class="form" id="docForm">
      <div class="grid2"><label>階層<select name="level">${["国","県","町"].map(x=>`<option${x===d.level?" selected":""}>${x}</option>`).join("")}</select></label>
      <label>種別<select name="kind">${["条例","規則","規程","要綱","要領","告示","通達","指針","ガイドライン","計画","例規集","その他"].map(x=>`<option${x===d.kind?" selected":""}>${x}</option>`).join("")}</select></label></div>
      <label>名称<input name="title" required value="${esc(d.title)}"></label>
      <div class="grid2"><label>制定・発出者<input name="issuer" value="${esc(d.issuer)}"></label><label>番号・制定日<input name="number" value="${esc(d.number)}" placeholder="例：令和○年条例第○号"></label></div>
      <label>原典URL（任意）<input name="url" value="${esc(d.url)}" placeholder="https://"></label>
      <label>概要<textarea name="summary">${esc(d.summary)}</textarea></label>
      <label>タグ（カンマ区切り）<input name="tags" value="${esc((d.tags||[]).join(","))}"></label>
      <div class="actions"><button class="btn pri" type="submit">保存</button></div>
    </form>
    <div class="sec-h">登録済み <span class="n">${U.docs.length}件</span></div>${list}
    <div class="sec-h">関連づけ <span class="n">${U.links.length}件</span></div>
    ${U.links.map((l,n)=>`<div class="rel-item"><a href="${esc(hrefOfKey(l.a))}">${esc(titleOfKey(l.a))}</a> ⇄ <a href="${esc(hrefOfKey(l.b))}">${esc(titleOfKey(l.b))}</a><span class="rn">${esc(l.rel)} <button class="rm" data-rmlink="${n}">✕</button></span></div>`).join("")||`<div class="empty">なし</div>`}
    <div class="sec-h">バックアップ</div>
    <div class="actions"><button class="btn" id="exp">書き出し（JSON）</button><label class="btn" style="cursor:pointer">読み込み<input type="file" id="imp" accept=".json" hidden></label></div>
    <p class="hint">ブラウザの保存領域は消える場合があります。定期的に書き出して保管してください。恒久的に組み込むには <code>data/curated.json</code> に追記し <code>build_data.py</code> を実行します。</p>
  </div>`;
  $("#docForm").onsubmit=e=>{
    e.preventDefault(); const f=Object.fromEntries(new FormData(e.target));
    const rec={level:f.level,kind:f.kind,title:f.title.trim(),issuer:f.issuer.trim(),number:f.number.trim(),url:f.url.trim(),summary:f.summary.trim(),
      tags:f.tags.split(/[,、]/).map(s=>s.trim()).filter(Boolean),related:(ed&&ed.related)||[]};
    if(ed&&ed.id){ const n=U.docs.findIndex(x=>x.id===ed.id); U.docs[n]=Object.assign({},U.docs[n],rec); }
    else { rec.id="U-"+Date.now().toString(36); U.docs.push(rec); }
    save(); buildItems(); initTagChips(); toast("保存しました"); location.hash="#/doc/"+(ed&&ed.id?ed.id:rec.id);
  };
  $("#exp").onclick=()=>{ const b=new Blob([JSON.stringify(U,null,1)],{type:"application/json"}); const a=document.createElement("a"); a.href=URL.createObjectURL(b); a.download="reiki_mine_"+new Date().toISOString().slice(0,10)+".json"; a.click(); };
  $("#imp").onchange=e=>{ const f=e.target.files[0]; if(!f)return; f.text().then(t=>{ try{ const j=JSON.parse(t); U=Object.assign({docs:[],links:[],memos:{},recent:[]},j); save(); buildItems(); toast("読み込みました"); route(); }catch(x){ toast("読み込みに失敗しました"); } }); };
}
function initTagChips(){ renderResults(); }

