/* ======================= ルーティング ======================= */
function route(){
  const h=location.hash||"#/"; const [path,qs]=h.slice(1).split("?"); const seg=path.split("/").filter(Boolean);
  const v=seg[0]||"home"; ARTQ=(v==="law"&&CURKEY==="L:"+seg[1])?ARTQ:"";
  document.querySelectorAll("[data-nav]").forEach(a=>a.classList.toggle("on",a.dataset.nav===(["law","doc"].includes(v)?"home":v)));
  const single=["updates","mine","help"].includes(v); $("#wrap").classList.toggle("single",single);
  const qp=new URLSearchParams(qs||"");
  if(v==="law"){ if(CURKEY!=="L:"+seg[1]) TAB="rel"; if(qp.get("tab")) TAB=qp.get("tab"); showLaw(seg[1]); }
  else if(v==="doc"){ if(CURKEY!=="D:"+seg[1]) TAB="rel"; showDoc(seg[1]); }
  else if(v==="updates") showUpdates();
  else if(v==="mine") showMine(qs);
  else if(v==="help") showHelp();
  else showHome();
  if(!single) renderResults();
  if(["law","doc"].includes(v) && innerWidth<=980) $("#main").scrollIntoView({behavior:"smooth"});
  else if(v!=="home"||!single) window.scrollTo({top:0});
}
document.addEventListener("click",e=>{
  const t=e.target.closest("[data-togg]"); if(t){ t.closest(".rel-group").classList.toggle("open"); e.preventDefault(); return; }
  const r=e.target.closest("[data-rmlink]"); if(r){ e.preventDefault(); e.stopPropagation(); if(confirm("この関連づけを削除しますか？")){U.links.splice(+r.dataset.rmlink,1);save();route();} return; }
  const dd=e.target.closest("[data-deldoc]"); if(dd){ e.preventDefault(); e.stopPropagation(); if(confirm("この登録を削除しますか？（関連づけも解除されます）")){ const id=dd.dataset.deldoc; U.docs=U.docs.filter(x=>x.id!==id); U.links=U.links.filter(l=>l.a!=="D:"+id&&l.b!=="D:"+id); save(); buildItems(); route(); } }
});
window.addEventListener("hashchange",route);

/* ======================= 起動 ======================= */
function setTheme(t){ document.documentElement.dataset.theme=t; $("#themeBtn").textContent=t==="dark"?"☀ 昼":"☾ 夜"; U.theme=t; save(); }
$("#themeBtn").onclick=()=>setTheme(document.documentElement.dataset.theme==="dark"?"light":"dark");
setTheme(new URLSearchParams(location.search).get("theme")||U.theme||(matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"));
$("#subline").textContent=`国・${SET.prefecture||"県"}・${SET.town||"町"}の法令・条例・規則・指針を横断して調べる`;
(function(){
  const days=daysSince(META.lastChecked);
  if(days>31) { $("#banner").innerHTML=`<div class="banner">最終の法改正確認から <b>${days>=9999?"（未確認）":days+"日"}</b> が経過しています。<a href="#/updates">月次更新の手順</a>を確認し、<code>monthly_update.bat</code> を実行してください。</div>`; $("#updDot").hidden=false; }
  const lg=LOG[0]; if(lg && w2(lg)) $("#updDot").hidden=false;
  function w2(lg){ const w=watchedIds(); return lg.changed.some(c=>w.has(c[0])); }
  $("#foot").textContent=`データ生成：${META.builtAt||"—"} ／ 法令 ${L.length.toLocaleString()} 件`;
})();
initFilters();
{ const q0=new URLSearchParams(location.search).get("q"); if(q0){ F.q=q0; $("#q").value=q0; } }
route();
}
boot();
