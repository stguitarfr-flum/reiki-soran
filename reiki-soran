<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>例規総覧 — Compendium of Statutes</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Noto+Serif+JP:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#f4efe3; --card:#fffdf7; --ink:#1c2030; --muted:#6b6a64;
  --navy:#0f2342; --navy2:#1d3b69; --crimson:#8b1e2d; --gold:#b38b3f; --gold2:#d9bd7e;
  --rule:#d9cfb8; --hl:#fbeeb8; --forest:#2f5d46; --shadow:0 1px 0 rgba(15,35,66,.06),0 8px 24px -12px rgba(15,35,66,.25);
  --serif:"Cormorant Garamond","Palatino Linotype","Book Antiqua","Noto Serif JP","Hiragino Mincho ProN","Yu Mincho","YuMincho","MS PMincho",Georgia,serif;
}
:root[data-theme="dark"]{
  --paper:#0c1424; --card:#121c33; --ink:#ece6d6; --muted:#9aa0ad; --navy:#08111f; --navy2:#2a4a80;
  --crimson:#d2596a; --gold:#d4ad5f; --gold2:#e6cd93; --rule:#2a3552; --hl:#5a4a14; --forest:#6fb08c;
  --shadow:0 1px 0 rgba(0,0,0,.4),0 10px 28px -12px rgba(0,0,0,.7);
}
*{box-sizing:border-box}
#gate[hidden]{display:none!important}
html{scroll-behavior:smooth}
body{margin:0;font-variant-numeric:lining-nums;background:var(--paper);color:var(--ink);font-family:var(--serif);font-size:16px;line-height:1.75;
  background-image:radial-gradient(rgba(179,139,63,.07) 1px,transparent 1px);background-size:22px 22px}
a{color:var(--navy2);text-decoration:none}
a:hover{color:var(--crimson);text-decoration:underline}
:root[data-theme="dark"] a{color:#9bb7e6}
button{font-family:inherit;cursor:pointer}
input,select,textarea{font-family:inherit;font-size:15px;color:var(--ink)}

/* ---------- Masthead ---------- */
.mast{background:var(--navy);color:#f3ecd9;position:relative;border-bottom:4px double var(--gold);
  background-image:
   linear-gradient(135deg,rgba(255,255,255,.035) 25%,transparent 25%,transparent 50%,rgba(255,255,255,.035) 50%,rgba(255,255,255,.035) 75%,transparent 75%);
  background-size:36px 36px}
.mast::after{content:"";position:absolute;left:0;right:0;bottom:3px;height:1px;background:var(--gold2);opacity:.5}
.mast-in{max-width:1500px;margin:0 auto;padding:18px 24px 14px;display:flex;align-items:center;gap:20px;flex-wrap:wrap}
.crest{width:58px;height:66px;flex:none;filter:drop-shadow(0 2px 3px rgba(0,0,0,.4))}
.brand h1{margin:0;font-size:32px;letter-spacing:.18em;font-weight:700;line-height:1.15}
.brand .en{font-size:12.5px;letter-spacing:.32em;text-transform:uppercase;color:var(--gold2);font-weight:600}
.brand .sub{font-size:13px;color:#c9c2ae;letter-spacing:.06em}
.nav{margin-left:auto;display:flex;gap:4px;flex-wrap:wrap;align-items:center}
.nav a,.nav button{color:#efe7d2;background:none;border:0;padding:8px 14px;font-size:15px;letter-spacing:.1em;border-bottom:2px solid transparent;text-decoration:none}
.nav a:hover,.nav button:hover{color:var(--gold2);border-bottom-color:var(--gold)}
.nav a.on{border-bottom-color:var(--gold2);color:var(--gold2)}
.nav .dot[hidden]{display:none}
.nav .dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#e04b5d;margin-left:6px;vertical-align:middle}

.banner{background:#fff4d6;color:#4d3a08;border-bottom:1px solid var(--gold);padding:9px 24px;font-size:14.5px;text-align:center}
:root[data-theme="dark"] .banner{background:#3a2f10;color:#f3dfa6}
.banner b{color:var(--crimson)}

/* ---------- Layout ---------- */
.wrap{max-width:1500px;margin:0 auto;padding:22px 24px 60px;display:grid;grid-template-columns:minmax(340px,430px) 1fr;gap:26px;align-items:start}
.wrap.single{grid-template-columns:1fr;max-width:1100px}
.wrap.single #left{display:none}
@media(max-width:980px){.wrap{grid-template-columns:1fr;padding:14px 12px 50px}.mast-in{padding:14px 14px 10px}.brand h1{font-size:25px}}

.panel{background:var(--card);border:1px solid var(--rule);box-shadow:var(--shadow);position:relative}
.panel::before{content:"";position:absolute;inset:4px;border:1px solid var(--rule);pointer-events:none;opacity:.7}
#left{position:sticky;top:12px;max-height:calc(100vh - 24px);display:flex;flex-direction:column}
@media(max-width:980px){#left{position:static;max-height:none}}
.searchbox{padding:18px 18px 10px}
.searchbox label.cap{font-size:11.5px;letter-spacing:.3em;color:var(--crimson);text-transform:uppercase;font-weight:700;display:block;margin-bottom:6px}
.sw{position:relative}
#q{width:100%;padding:12px 14px 12px 42px;border:1px solid var(--navy);background:#fff;font-size:18px;border-radius:2px;outline:none;color:#1c2030}
:root[data-theme="dark"] #q{background:#0c1424;color:#ece6d6;border-color:var(--gold)}
#q:focus{box-shadow:0 0 0 3px rgba(179,139,63,.35)}
.sw svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:20px;height:20px;stroke:var(--navy2);fill:none;stroke-width:2}
:root[data-theme="dark"] .sw svg{stroke:var(--gold)}
.hint{font-size:12.5px;color:var(--muted);margin:6px 0 0}
.filters{padding:2px 18px 12px;display:grid;gap:8px}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{border:1px solid var(--rule);background:transparent;color:var(--ink);padding:3px 11px;border-radius:999px;font-size:13.5px;letter-spacing:.04em}
.chip:hover{border-color:var(--gold)}
.chip.on{background:var(--navy);border-color:var(--navy);color:#f6efdc}
:root[data-theme="dark"] .chip.on{background:var(--gold);color:#101828;border-color:var(--gold)}
.chip.lv-国.on{background:var(--navy)}.chip.lv-県.on{background:var(--forest);border-color:var(--forest);color:#fff}.chip.lv-町.on{background:var(--crimson);border-color:var(--crimson);color:#fff}
.frow{display:flex;gap:8px;flex-wrap:wrap}
.frow select{flex:1;min-width:130px;padding:6px 8px;border:1px solid var(--rule);background:var(--card);border-radius:2px}
.frow label{font-size:13.5px;display:flex;align-items:center;gap:5px}
.resmeta{padding:8px 18px;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);font-size:13px;color:var(--muted);letter-spacing:.06em;display:flex;justify-content:space-between;background:rgba(179,139,63,.07)}
#results{overflow:auto;flex:1;min-height:120px}
.res{display:block;padding:11px 18px 11px 16px;border-bottom:1px solid var(--rule);border-left:3px solid transparent;color:var(--ink)}
.res:hover{background:rgba(179,139,63,.1);text-decoration:none;color:var(--ink)}
.res.sel{border-left-color:var(--crimson);background:rgba(139,30,45,.07)}
.res .t{font-weight:600;font-size:16.5px;line-height:1.4}
.res .m{font-size:12.5px;color:var(--muted);margin-top:2px;display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.more-btn{display:block;width:100%;padding:12px;background:none;border:0;border-top:1px solid var(--rule);color:var(--navy2);font-size:14px}
mark{background:var(--hl);color:inherit;padding:0 1px}

.badge{display:inline-block;font-size:11.5px;letter-spacing:.08em;padding:0 8px;line-height:20px;border:1px solid currentColor;border-radius:2px;white-space:nowrap}
.b-国{color:var(--navy2)}.b-県{color:var(--forest)}.b-町{color:var(--crimson)}
:root[data-theme="dark"] .b-国{color:#9bb7e6}
.b-kind{color:var(--gold);}
:root[data-theme="light"] .b-kind,:root:not([data-theme]) .b-kind{color:#8a6a24}
.b-warn{color:#fff;background:var(--crimson);border-color:var(--crimson)}
.b-ok{color:var(--forest)}
.b-fill{color:#fff;background:var(--navy);border-color:var(--navy)}

/* ---------- Detail ---------- */
#main{min-height:60vh}
.dhead{padding:28px 34px 18px;border-bottom:1px solid var(--rule)}
.dhead .eyebrow{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:10px}
.dhead h2{margin:0;font-size:31px;line-height:1.35;letter-spacing:.04em;font-weight:700;color:var(--navy)}
:root[data-theme="dark"] .dhead h2{color:#f0e8d2}
.dhead .abbr{color:var(--crimson);font-style:italic;font-size:16px;margin-top:2px}
.dl{display:grid;grid-template-columns:auto 1fr;gap:3px 18px;margin:14px 0 0;font-size:14.5px}
.dl dt{color:var(--muted);letter-spacing:.12em;font-size:12.5px;text-transform:uppercase;padding-top:2px}
.dl dd{margin:0}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}
.btn{border:1px solid var(--navy);background:transparent;color:var(--navy);padding:6px 14px;font-size:14px;letter-spacing:.06em;border-radius:2px}
:root[data-theme="dark"] .btn{color:var(--gold2);border-color:var(--gold)}
.btn:hover{background:var(--navy);color:#f6efdc;text-decoration:none}
.btn.pri{background:var(--navy);color:#f6efdc}
.btn.pri:hover{background:var(--crimson);border-color:var(--crimson)}
.btn.danger{color:var(--crimson);border-color:var(--crimson)}.btn.danger:hover{background:var(--crimson);color:#fff}
.tabs{display:flex;border-bottom:1px solid var(--rule);padding:0 28px;gap:2px;background:rgba(179,139,63,.06)}
.tabs button{background:none;border:0;border-bottom:3px solid transparent;padding:11px 18px;font-size:16px;letter-spacing:.12em;color:var(--muted);margin-bottom:-1px}
.tabs button.on{color:var(--crimson);border-bottom-color:var(--crimson);font-weight:700}
.tabs button:hover{color:var(--navy2)}
.pane{padding:22px 34px 34px}
.sec-h{font-size:12.5px;letter-spacing:.3em;text-transform:uppercase;color:var(--crimson);font-weight:700;margin:26px 0 8px;display:flex;align-items:center;gap:12px}
.sec-h:first-child{margin-top:0}
.sec-h::after{content:"";flex:1;height:1px;background:linear-gradient(90deg,var(--gold),transparent)}
.sec-h .n{color:var(--muted);letter-spacing:.05em;font-weight:400;text-transform:none}
.rel-group .sec-h{margin-top:26px}
.rel-group.more .rel-item.x{display:none}
.rel-group.more.open .rel-item.x{display:flex}
.rel-item{display:flex;gap:9px;align-items:baseline;padding:7px 10px;border-bottom:1px dotted var(--rule);color:var(--ink);flex-wrap:wrap}
.rel-item:hover{background:rgba(179,139,63,.12);text-decoration:none;color:var(--ink)}
.rel-item .rt{font-weight:600}
.rel-item .rn{font-size:12.5px;color:var(--muted);margin-left:auto}
.rel-item .rm{color:var(--crimson);font-size:12px;cursor:pointer;border:0;background:none;padding:0 4px}
.togg{background:none;border:0;color:var(--navy2);font-size:13.5px;padding:6px 10px}
.rel-group.open .togg-open,.rel-group:not(.open) .togg-close{display:none}
.mapwrap{border:1px solid var(--rule);background:linear-gradient(180deg,rgba(179,139,63,.06),transparent);margin:6px 0 4px;overflow:auto}
.mapwrap svg{display:block;margin:0 auto;min-width:640px}
.mapwrap text{font-family:var(--serif)}
.mapwrap .nd{cursor:pointer}
.mapwrap .nd:hover rect{stroke-width:2.4}
.empty{color:var(--muted);font-style:italic;padding:8px 10px}
.note{font-size:13px;color:var(--muted);border-left:3px solid var(--gold);padding:4px 12px;margin:10px 0;background:rgba(179,139,63,.07)}

/* ---------- Law text ---------- */
.txtbar{display:flex;gap:10px;align-items:center;margin-bottom:14px;flex-wrap:wrap}
.txtbar input{flex:1;min-width:200px;padding:8px 12px;border:1px solid var(--rule);background:var(--card);border-radius:2px}
.txtgrid{display:grid;grid-template-columns:200px 1fr;gap:24px}
@media(max-width:900px){.txtgrid{grid-template-columns:1fr}.toc{display:none}}
.toc{position:sticky;top:12px;max-height:75vh;overflow:auto;font-size:13px;border-right:1px solid var(--rule);padding-right:10px}
.toc a{display:block;padding:3px 0;color:var(--ink);line-height:1.45}
.toc a.l1{padding-left:12px;color:var(--muted)}
.art{padding:10px 0 14px;border-bottom:1px dotted var(--rule);scroll-margin-top:16px}
.art.flash{animation:fl 1.6s}
@keyframes fl{0%{background:var(--hl)}100%{background:transparent}}
.art .ah{font-weight:700;color:var(--navy);margin-bottom:2px}
:root[data-theme="dark"] .art .ah{color:var(--gold2)}
.art .cap{color:var(--muted);font-weight:400;margin-left:6px;font-size:14px}
.art .body{white-space:pre-wrap;font-size:16px;line-height:1.95;text-align:justify}
.hd{font-weight:700;font-size:17px;margin:26px 0 4px;color:var(--crimson);letter-spacing:.08em;border-bottom:1px solid var(--gold);padding-bottom:3px}
.hd.l1{font-size:15.5px;color:var(--navy);margin-top:18px;border-bottom:1px dotted var(--rule)}
:root[data-theme="dark"] .hd.l1{color:var(--gold2)}
.xref{color:var(--navy2);border-bottom:1px dotted var(--navy2);cursor:pointer}
.lref{color:var(--crimson);border-bottom:1px solid var(--crimson)}

/* ---------- forms / misc ---------- */
.form{display:grid;gap:12px;max-width:720px}
.form label{display:grid;gap:3px;font-size:13px;color:var(--muted);letter-spacing:.1em}
.form input,.form select,.form textarea{padding:8px 10px;border:1px solid var(--rule);background:var(--card);border-radius:2px;width:100%}
.form textarea{min-height:90px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:700px){.grid2{grid-template-columns:1fr}}
.modal{position:fixed;inset:0;background:rgba(8,17,31,.6);display:flex;align-items:flex-start;justify-content:center;z-index:50;padding:8vh 14px}
.modal .box{background:var(--card);border:1px solid var(--gold);width:min(680px,100%);max-height:80vh;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(0,0,0,.5)}
.modal .box h3{margin:0;padding:16px 20px;border-bottom:1px solid var(--rule);font-size:19px;letter-spacing:.1em;color:var(--navy)}
:root[data-theme="dark"] .modal .box h3{color:var(--gold2)}
.modal .mb{padding:14px 20px;overflow:auto}
.pick{display:flex;gap:8px;align-items:baseline;padding:8px 6px;border-bottom:1px dotted var(--rule);cursor:pointer;flex-wrap:wrap}
.pick:hover{background:rgba(179,139,63,.15)}
.log-block{border:1px solid var(--rule);margin:14px 0;background:var(--card)}
.log-block h4{margin:0;padding:10px 16px;background:rgba(179,139,63,.1);border-bottom:1px solid var(--rule);font-size:16px;letter-spacing:.08em;display:flex;gap:12px;flex-wrap:wrap}
.log-block ul{margin:0;padding:8px 16px 12px 34px}
.log-block li{margin:3px 0;font-size:14.5px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin:8px 0 18px}
.kpi{border:1px solid var(--rule);padding:12px 16px;background:var(--card);text-align:center}
.kpi b{display:block;font-size:30px;color:var(--navy);line-height:1.2}
:root[data-theme="dark"] .kpi b{color:var(--gold2)}
.kpi span{font-size:12px;letter-spacing:.16em;color:var(--muted)}
.hero{padding:44px 40px;text-align:center}
.hero h2{font-size:30px;letter-spacing:.14em;color:var(--navy);margin:0 0 6px}
:root[data-theme="dark"] .hero h2{color:var(--gold2)}
.hero p{max-width:640px;margin:8px auto;color:var(--muted)}
.motto{font-style:italic;color:var(--crimson);letter-spacing:.18em;font-size:14px;margin-top:20px}
.orn{display:flex;align-items:center;gap:14px;justify-content:center;color:var(--gold);margin:14px 0}
.orn::before,.orn::after{content:"";height:1px;width:90px;background:var(--gold)}
code,kbd{background:rgba(179,139,63,.15);padding:1px 6px;font-size:13.5px;border-radius:2px;font-family:Consolas,monospace}
pre{background:#101b30;color:#e8e0c8;padding:12px 16px;overflow:auto;font-size:13.5px}
footer{max-width:1500px;margin:0 auto;padding:0 24px 40px;color:var(--muted);font-size:12.5px;text-align:center;letter-spacing:.06em}
@media print{.mast,#left,.tabs,.actions,.banner,footer,.txtbar,.toc{display:none!important}.wrap{display:block;padding:0}.panel{border:0;box-shadow:none}.panel::before{display:none}}
</style>
</head>
<body>
<div id="gate" hidden style="position:fixed;inset:0;z-index:100;background:#0f2342;display:flex;align-items:center;justify-content:center;color:#f3ecd9;font-family:var(--serif)">
  <div style="text-align:center;max-width:380px;padding:30px;border:4px double #b38b3f;background:#0c1d38">
    <div style="font-size:12px;letter-spacing:.3em;color:#d9bd7e">COMPENDIUM OF STATUTES</div>
    <h1 style="margin:6px 0 4px;font-size:34px;letter-spacing:.2em">例規総覧</h1>
    <p style="font-size:14px;color:#c9c2ae;margin:0 0 18px">閲覧にはパスワードが必要です</p>
    <input id="gpw" type="password" autocomplete="current-password" placeholder="パスワード" style="width:100%;padding:12px;font-size:17px;border:1px solid #d9bd7e;background:#fff;color:#1c2030">
    <label style="display:block;margin:10px 0;font-size:13px"><input type="checkbox" id="gremember"> この端末で次回から入力を省略</label>
    <button id="gbtn" style="width:100%;padding:11px;font-size:16px;letter-spacing:.2em;background:#8b1e2d;color:#fff;border:1px solid #d9bd7e">開く</button>
    <p id="gmsg" style="min-height:1.5em;color:#f0b4bd;font-size:13px"></p>
  </div></div>
<header class="mast">
  <div class="mast-in">
    <svg class="crest" viewBox="0 0 60 68" aria-hidden="true">
      <path d="M30 2 L56 9 V34 C56 50 44 61 30 66 C16 61 4 50 4 34 V9 Z" fill="#0f2342" stroke="#d9bd7e" stroke-width="2.4"/>
      <path d="M30 6 L52 12 V34 C52 47 42 57 30 62 C18 57 8 47 8 34 V12 Z" fill="none" stroke="#b38b3f" stroke-width=".8"/>
      <path d="M13 24 Q22 21 30 25 Q38 21 47 24 V44 Q38 41 30 45 Q22 41 13 44 Z" fill="#f3ecd9" stroke="#d9bd7e" stroke-width="1"/>
      <path d="M30 25 V45" stroke="#b38b3f" stroke-width="1"/>
      <text x="21.5" y="39" font-size="12" text-anchor="middle" fill="#8b1e2d" font-family="serif" font-weight="700">例</text>
      <text x="38.5" y="39" font-size="12" text-anchor="middle" fill="#0f2342" font-family="serif" font-weight="700">規</text>
      <path d="M22 13 l1.4 2.8 3 .4 -2.2 2.1 .5 3 -2.7 -1.4 -2.7 1.4 .5 -3 -2.2 -2.1 3 -.4z" fill="#d9bd7e" transform="translate(7 -4) scale(.8)"/>
      <path d="M22 13 l1.4 2.8 3 .4 -2.2 2.1 .5 3 -2.7 -1.4 -2.7 1.4 .5 -3 -2.2 -2.1 3 -.4z" fill="#d9bd7e" transform="translate(17 -6) scale(.8)"/>
      <path d="M22 13 l1.4 2.8 3 .4 -2.2 2.1 .5 3 -2.7 -1.4 -2.7 1.4 .5 -3 -2.2 -2.1 3 -.4z" fill="#d9bd7e" transform="translate(27 -4) scale(.8)"/>
    </svg>
    <div class="brand">
      <div class="en">Compendium of Statutes &amp; Ordinances</div>
      <h1>例規総覧</h1>
      <div class="sub" id="subline">国・県・町の法令・条例・規則・指針を横断して調べる</div>
    </div>
    <nav class="nav">
      <a href="#/" data-nav="home">検索</a>
      <a href="#/updates" data-nav="updates">更新情報<span class="dot" id="updDot" hidden></span></a>
      <a href="#/mine" data-nav="mine">マイ登録</a>
      <a href="#/help" data-nav="help">使い方</a>
      <button id="themeBtn" title="昼 / 夜の切替">☾ 夜</button>
    </nav>
  </div>
</header>
<div id="banner"></div>
<div class="wrap" id="wrap">
  <aside id="left" class="panel">
    <div class="searchbox">
      <label class="cap" for="q">Search the Library</label>
      <div class="sw">
        <svg viewBox="0 0 24 24"><circle cx="10" cy="10" r="6.5"/><path d="M15 15l6 6"/></svg>
        <input id="q" type="search" autocomplete="off" placeholder="法令名・略称・番号・キーワード（例：耐震 空家 狩猟）">
      </div>
      <p class="hint">スペース区切りで AND 検索。ひらがな／カタカナどちらでも可。<kbd>/</kbd> で検索欄へ。</p>
    </div>
    <div class="filters">
      <div class="chips" id="lvChips"></div>
      <div class="frow">
        <select id="kindSel"></select>
        <select id="catSel"></select>
      </div>
      <div class="frow">
        <label><input type="checkbox" id="fText"> 条文収録のみ</label>
        <label><input type="checkbox" id="fDocs"> 指針・例規のみ</label>
        <label><input type="checkbox" id="fFreq"> 町業務頻用</label>
        <label title="町・県の例規PDFの本文まで検索（初回のみ読み込みに数秒）"><input type="checkbox" id="fBody"> 本文も検索</label>
      </div>
