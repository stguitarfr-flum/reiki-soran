<script src="site-config.js" onerror="void 0"></script>
<script>
"use strict";
/* ======================= データ読み込み（ローカル：scriptタグ／公開サイト：暗号化データを復号） ======================= */
const SITE = window.SITE_CONFIG || null;
let SITE_KEY = null;
const LOADED = new Map();
const b64d = s => Uint8Array.from(atob(s), c => c.charCodeAt(0));
async function deriveKey(pw){
  const base = await crypto.subtle.importKey("raw", new TextEncoder().encode(pw), "PBKDF2", false, ["deriveKey"]);
  return crypto.subtle.deriveKey({name:"PBKDF2", salt:b64d(SITE.salt), iterations:SITE.iter, hash:"SHA-256"}, base, {name:"AES-GCM", length:256}, true, ["decrypt"]);
}
async function decryptBuf(buf){
  const u=new Uint8Array(buf);
  const plain = await crypto.subtle.decrypt({name:"AES-GCM", iv:u.slice(0,12)}, SITE_KEY, u.slice(12));
  const ds = new Response(new Blob([plain]).stream().pipeThrough(new DecompressionStream("gzip")));
  return ds.text();
}
function loadData(path){
  if(LOADED.has(path)) return LOADED.get(path);
  const p = SITE
    ? fetch(path+".bin").then(r=>{ if(!r.ok) throw new Error(r.status); return r.arrayBuffer(); }).then(decryptBuf).then(js=>{ const s=document.createElement("script"); s.textContent=js; document.head.appendChild(s); })
    : new Promise(res=>{ const s=document.createElement("script"); s.src=path; s.onload=()=>res(); s.onerror=()=>res(); document.head.appendChild(s); });
  const q = p.catch(()=>{});
  LOADED.set(path,q); return q;
}
async function unlock(){
  const test = async key => { SITE_KEY=key; await decryptBuf(await (await fetch("data/meta.js.bin")).arrayBuffer()); };
  try{ const k=localStorage.getItem("reiki.v1.key"); if(k){ await test(await crypto.subtle.importKey("raw",b64d(k),"AES-GCM",true,["decrypt"])); return; } }catch(e){ try{localStorage.removeItem("reiki.v1.key");}catch(x){} }
  const g=document.getElementById("gate"); g.hidden=false;
  const inp=document.getElementById("gpw"), msg=document.getElementById("gmsg");
  await new Promise(done=>{
    const go=async()=>{
      msg.textContent="確認中…";
      try{
        const key=await deriveKey(inp.value); await test(key);
        if(document.getElementById("gremember").checked){ try{ localStorage.setItem("reiki.v1.key", btoa(String.fromCharCode(...new Uint8Array(await crypto.subtle.exportKey("raw",key))))); }catch(e){} }
        g.hidden=true; done();
      }catch(e){ msg.textContent="パスワードが違うか、データを読み込めません。"; }
    };
    document.getElementById("gbtn").onclick=go; inp.onkeydown=e=>{ if(e.key==="Enter") go(); }; inp.focus();
  });
}
async function boot(){
  if(SITE){
    if(!window.crypto||!crypto.subtle||typeof DecompressionStream==="undefined"){ document.body.innerHTML='<p style="padding:30px">このブラウザは対応していません。最新のChrome／Safari／Edgeをお使いください（https接続が必要です）。</p>'; return; }
    await unlock();
  }
  await Promise.all(["data/meta.js","data/laws_index.js","data/curated.js","data/local_docs.js","data/update_log.js"].map(loadData));
  startApp();
}
function startApp(){
/* ======================= 基本データ ======================= */
const L = window.LAW_INDEX.laws, CATS = window.LAW_INDEX.cats;
const CUR = window.CURATED, META = window.META || {}, LOG = window.UPDATE_LOG || [];
const SET = CUR.settings || {};
const LOC = window.LOCAL_DOCS || {docs:[],attach:{},counts:{}};
CUR.docs = CUR.docs.concat(LOC.docs);
const fileUrl = p => "file:///"+encodeURI(String(p).replace(/\\/g,"/")).replace(/#/g,"%23");
const I = {ID:0,TYPE:1,NUM:2,TITLE:3,KANA:4,PROM:5,CATS:6,EFF:7,AMN:8,UNENF:9,ABBR:10,AMEND:11,AMDATE:12,REFS:13};
const TYPE_RANK = {"憲法":0,"法律":1,"政令":2,"勅令":2,"府省令":3,"規則":3};
const LS_KEY = "reiki.v1.user";
const $ = s => document.querySelector(s);
const esc = s => String(s==null?"":s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const norm = s => String(s||"").normalize("NFKC").toLowerCase().replace(/[ァ-ヶ]/g,c=>String.fromCharCode(c.charCodeAt(0)-0x60));

let U = {docs:[],links:[],memos:{},recent:[],theme:null,ack:{}};
try{ const s=localStorage.getItem(LS_KEY); if(s) U=Object.assign(U,JSON.parse(s)); }catch(e){}
const save = () => { try{ localStorage.setItem(LS_KEY,JSON.stringify(U)); }catch(e){} };

/* ---- 索引構築 ---- */
const idxById = new Map(L.map((l,i)=>[l[I.ID],i]));
const numMap = new Map(); L.forEach((l,i)=>{ if(!numMap.has(l[I.NUM])) numMap.set(l[I.NUM],i); });
const rev = L.map(()=>[]);
L.forEach((l,i)=>l[I.REFS].forEach(([j,c])=>rev[j].push([i,c])));
const textIds = new Set(CUR.textIds||[]);
const lawTags = CUR.lawTags||{};

function allDocs(){ return CUR.docs.concat(U.docs.map(d=>Object.assign({user:true},d))); }
function docById(id){ return allDocs().find(d=>d.id===id); }

let ITEMS = [];
function buildItems(){
  const tagFreq = {};
  ITEMS = L.map((l,i)=>{
    const tags = lawTags[l[I.ID]]||[];
    tags.forEach(t=>tagFreq[t]=(tagFreq[t]||0)+1);
    return {key:"L:"+l[I.ID],kind:"law",i,level:"国",cls:l[I.TYPE],title:l[I.TITLE],tags,
      t:norm(l[I.TITLE]),
      hay:norm([l[I.TITLE],l[I.KANA],l[I.ABBR],l[I.NUM],tags.join(" "),(l[I.CATS]||[]).map(c=>CATS[c]).join(" ")].join(" ")),
      ab:norm(l[I.ABBR]),text:textIds.has(l[I.ID]),freq:tags.includes("町業務頻用"),unenf:!!l[I.UNENF]};
  });
  allDocs().forEach(d=>{
    (d.tags||[]).forEach(t=>tagFreq[t]=(tagFreq[t]||0)+1);
    ITEMS.push({key:"D:"+d.id,kind:"doc",d,level:d.level,cls:d.kind,title:d.title,tags:d.tags||[],
      t:norm(d.title),hay:norm([d.title,d.issuer,d.number,d.summary,(d.tags||[]).join(" "),d.kind,d.level].join(" ")),ab:"",text:false,freq:false});
  });
  window.TAGFREQ = tagFreq;
}
buildItems();
const DT_GROUPS=[...new Set(CUR.docs.filter(d=>d.tg).map(d=>d.tg))];
function loadDText(g){ window.DTEXT=window.DTEXT||{}; return loadData("data/dtexts/"+g+".js"); }
async function ensureBodies(){ await Promise.all(DT_GROUPS.map(loadDText)); ITEMS.forEach(it=>{ if(it.kind==="doc"&&it.d.hasText&&!it.body&&window.DTEXT&&DTEXT[it.d.id]) it.body=norm(DTEXT[it.d.id]); }); }

/* ======================= 検索 ======================= */
const F = {body:false,q:"",levels:new Set(),kind:"",cat:"",text:false,docs:false,freq:false,tag:"",limit:150};
function score(it,toks){
  let s=0;
  for(const t of toks){
    if(!it.hay.includes(t)) return -1;
    if(it.t===t) s+=100; else if(it.t.startsWith(t)) s+=60; else if(it.ab&&it.ab.includes(t)) s+=70;
    else if(it.t.includes(t)) s+=40; else s+=10;
  }
  if(it.kind==="doc") s+=8; if(it.tags.length) s+=5; if(it.text) s+=3;
  if(it.cls==="法律"||it.cls==="憲法") s+=4;
  s-=Math.min(it.title.length,60)*0.05;
  return s;
}
function runSearch(){
  const toks = norm(F.q).split(/\s+/).filter(Boolean);
  const out=[];
  for(const it of ITEMS){
    if(F.levels.size && !F.levels.has(it.level)) continue;
    if(F.kind && it.cls!==F.kind) continue;
    if(F.cat && !(it.kind==="law" && L[it.i][I.CATS].includes(+F.cat))) continue;
    if(F.text && !it.text) continue;
    if(F.docs && it.kind!=="doc") continue;
    if(F.freq && !it.freq) continue;
    if(F.tag && !it.tags.includes(F.tag)) continue;
    let s=0;
    if(toks.length){ s=score(it,toks); if(s<0){ if(F.body && it.body && toks.every(t=>it.body.includes(t))) s=2; else continue; } }
    else { s = (it.freq?50:0)+(it.kind==="doc"?(it.d.local?3:30):0)+(it.tags.length?10:0)+(it.text?5:0); }
    out.push([s,it]);
  }
  const noCond = !toks.length && !F.levels.size && !F.kind && !F.cat && !F.text && !F.docs && !F.freq && !F.tag;
  out.sort((a,b)=>b[0]-a[0] || (a[1].title<b[1].title?-1:1));
  return {list:out.map(x=>x[1]),noCond,toks};
}
function hl(text,toks){
  let h=esc(text);
  if(!toks.length) return h;
  const n=norm(text); if(n.length!==text.length) return h;
  const marks=new Array(text.length).fill(false);
  toks.forEach(t=>{ let p=0; while((p=n.indexOf(t,p))>=0){ for(let k=0;k<t.length;k++) marks[p+k]=true; p+=t.length; } });
  let r="",open=false;
  for(let k=0;k<text.length;k++){
    if(marks[k]&&!open){r+="<mark>";open=true;} if(!marks[k]&&open){r+="</mark>";open=false;}
    r+=esc(text[k]);
  }
  return r+(open?"</mark>":"");
}
function levelBadge(lv){ return `<span class="badge b-${lv}">${lv}</span>`; }
function clsBadge(c){ return `<span class="badge b-kind">${esc(c)}</span>`; }

function renderResults(){
  const {list,noCond,toks}=runSearch();
  const cur = curKey();
  $("#resCount").textContent = noCond ? `主な収録（${list.length.toLocaleString()} 件中 上位）` : `${list.length.toLocaleString()} 件ヒット`;
  const shown = list.slice(0,F.limit);
  const parts = shown.map(it=>{
    const sub=[];
    if(it.kind==="law"){ const l=L[it.i]; sub.push(esc(l[I.NUM])); if(l[I.ABBR]) sub.push("略称："+esc(l[I.ABBR])); if(it.unenf) sub.push('<span class="badge b-warn">未施行あり</span>'); if(it.text) sub.push("📖条文収録"); }
    else { sub.push(esc(it.d.issuer||"")); if(it.d.number) sub.push(esc(it.d.number)); if(it.d.user) sub.push("マイ登録"); if(it.d.sample) sub.push('<span class="badge b-warn">登録例</span>'); }
    return `<a class="res${it.key===cur?" sel":""}" href="#/${it.kind==="law"?"law/"+L[it.i][I.ID]:"doc/"+esc(it.d.id)}">
      <div class="t">${hl(it.title,toks)}</div>
      <div class="m">${levelBadge(it.level)}${clsBadge(it.cls)}${sub.filter(Boolean).map(s=>`<span>${s}</span>`).join("")}</div></a>`;
  });
  let html = parts.join("") || `<div class="empty" style="padding:22px">該当する例規がありません。語句を変えるか、条件をクリアしてください。</div>`;
  if(list.length>shown.length) html+=`<button class="more-btn" id="moreBtn">さらに表示（残り ${(list.length-shown.length).toLocaleString()} 件）</button>`;
  $("#results").innerHTML=html;
  const mb=$("#moreBtn"); if(mb) mb.onclick=()=>{F.limit+=200;renderResults();};
}

function initFilters(){
  $("#lvChips").innerHTML = ["国","県","町"].map(l=>`<button class="chip lv-${l}" data-lv="${l}">${l}の例規</button>`).join("");
  $("#lvChips").onclick=e=>{const b=e.target.closest("[data-lv]"); if(!b)return; const l=b.dataset.lv; F.levels.has(l)?F.levels.delete(l):F.levels.add(l); b.classList.toggle("on"); F.limit=150; renderResults();};
  const kinds=["憲法","法律","政令","府省令","規則","条例","要綱","告示","通達","指針","ガイドライン","計画","例規集"];
  $("#kindSel").innerHTML=`<option value="">種別：すべて</option>`+kinds.map(k=>`<option>${k}</option>`).join("");
  $("#catSel").innerHTML=`<option value="">分野：すべて</option>`+Object.entries(CATS).map(([k,v])=>`<option value="${k}">${esc(v)}</option>`).join("");
  const tags=Object.entries(window.TAGFREQ).filter(([t])=>t!=="町業務頻用").sort((a,b)=>b[1]-a[1]).slice(0,14).map(x=>x[0]);
  $("#tagChips").innerHTML=tags.map(t=>`<button class="chip" data-tag="${esc(t)}">#${esc(t)}</button>`).join("");
  $("#tagChips").onclick=e=>{const b=e.target.closest("[data-tag]"); if(!b)return; const t=b.dataset.tag; F.tag=(F.tag===t?"":t); document.querySelectorAll("#tagChips .chip").forEach(c=>c.classList.toggle("on",c.dataset.tag===F.tag)); F.limit=150; renderResults();};
  $("#kindSel").onchange=e=>{F.kind=e.target.value;F.limit=150;renderResults();};
  $("#catSel").onchange=e=>{F.cat=e.target.value;F.limit=150;renderResults();};
  $("#fText").onchange=e=>{F.text=e.target.checked;F.limit=150;renderResults();};
  $("#fDocs").onchange=e=>{F.docs=e.target.checked;F.limit=150;renderResults();};
  $("#fFreq").onchange=e=>{F.freq=e.target.checked;F.limit=150;renderResults();};
  $("#fBody").onchange=async e=>{ F.body=e.target.checked; if(F.body){ $("#resCount").textContent="本文を読み込み中…"; await ensureBodies(); } F.limit=150; renderResults(); };
  let tm; $("#q").oninput=e=>{clearTimeout(tm);tm=setTimeout(()=>{F.q=e.target.value;F.limit=150;renderResults();},90);};
  $("#clearF").onclick=e=>{e.preventDefault();F.q="";F.levels.clear();F.kind=F.cat=F.tag="";F.text=F.docs=F.freq=false;F.limit=150;
    $("#q").value="";$("#kindSel").value="";$("#catSel").value="";["#fText","#fDocs","#fFreq"].forEach(s=>$(s).checked=false);
    document.querySelectorAll(".chip.on").forEach(c=>c.classList.remove("on")); renderResults();};
  document.addEventListener("keydown",e=>{ if(e.key==="/" && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)){e.preventDefault();$("#q").focus();$("#q").select();} });
}

/* ======================= 関連法規の計算 ======================= */
function itemOf(key){ return key.startsWith("L:")?{kind:"law",i:idxById.get(key.slice(2))}:{kind:"doc",d:docById(key.slice(2))}; }
function titleOfKey(key){ const it=itemOf(key); return it.kind==="law"?(it.i!=null?L[it.i][I.TITLE]:key):(it.d?it.d.title:key); }
function hrefOfKey(key){ return key.startsWith("L:")?"#/law/"+key.slice(2):"#/doc/"+key.slice(2); }
function levelOfKey(key){ const it=itemOf(key); return it.kind==="law"?"国":(it.d?it.d.level:"国"); }
function clsOfKey(key){ const it=itemOf(key); return it.kind==="law"?L[it.i][I.TYPE]:(it.d?it.d.kind:""); }

function docLinks(){ // 全ての「文書⇄法令/文書」の関係を (a,b,rel,user) の配列に
  const out=[];
  allDocs().forEach(d=>(d.related||[]).forEach(r=>{
    const b = r.law?("L:"+r.law):("D:"+r.doc);
    out.push({a:"D:"+d.id,b,rel:r.rel||"関連",user:!!d.user});
  }));
  U.links.forEach((l,n)=>out.push({a:l.a,b:l.b,rel:l.rel||"関連",user:true,n}));
  return out;
}
function relationsFor(key){
  const g = {base:[],impl:[],peer:[],cite:[],citedBy:[],docs:{国:[],県:[],町:[]},mine:[]};
  const seen = new Set([key]);
  const links = docLinks().filter(x=>x.a===key||x.b===key);
  if(key.startsWith("L:")){
    const i=idxById.get(key.slice(2)); const l=L[i]; const rank=TYPE_RANK[l[I.TYPE]]??9; const title=l[I.TITLE];
    // 直接の下位法令（施行令・施行規則）／根拠となる法律
    const m = title.match(/^(.*?)(施行令|施行規則|施行細則)$/);
    if(m){ const pi=L.findIndex(x=>x[I.TITLE]===m[1] && x[I.TYPE]!=="府省令"||x[I.TITLE]===m[1]); if(pi>=0){ g.base.push({key:"L:"+L[pi][I.ID],note:"根拠法"}); seen.add("L:"+L[pi][I.ID]); } }
    L.forEach((x,j)=>{ if(j!==i && x[I.TITLE].startsWith(title) && /(施行令|施行規則|施行細則)/.test(x[I.TITLE].slice(title.length)) && x[I.TITLE].length-title.length<10){
        const k="L:"+x[I.ID]; if(!seen.has(k)){seen.add(k); g.impl.push({key:k,note:x[I.TYPE]+"（施行）",w:1e6});} } });
    const mk=(j,c,dir)=>{ const x=L[j], k="L:"+x[I.ID]; if(seen.has(k)) return; seen.add(k);
      const r=TYPE_RANK[x[I.TYPE]]??9; const note="引用 "+c+"回";
      if(dir==="out"){ if(r<rank) g.base.push({key:k,note,w:c}); else if(r===rank) g.cite.push({key:k,note,w:c}); else g.cite.push({key:k,note,w:c}); }
      else { if(r>rank) g.impl.push({key:k,note:x[I.TYPE]+"・"+note,w:c}); else if(r===rank) g.citedBy.push({key:k,note,w:c}); else g.citedBy.push({key:k,note,w:c}); }
    };
    l[I.REFS].forEach(([j,c])=>mk(j,c,"out"));
    rev[i].sort((a,b)=>b[1]-a[1]).forEach(([j,c])=>mk(j,c,"in"));
  }
  links.forEach(x=>{
    const other = x.a===key?x.b:x.a;
    if(other===key) return;
    const lv = levelOfKey(other);
    const entry={key:other,note:x.rel+(x.user&&x.n!=null?"":""),user:x.user,n:x.n,w:1e9};
    if(x.user && x.n!=null){ g.mine.push(entry); return; }
    const kind = clsOfKey(other);
    if(other.startsWith("L:")){ if(!seen.has(other)||true){ g.base.unshift({key:other,note:x.rel,w:1e9}); } }
    else (g.docs[lv]||g.docs["国"]).push(entry);
    seen.add(other);
  });
  // 重複除去（キー単位）
  const dedupe = arr=>{ const s=new Set(); return arr.filter(a=>s.has(a.key)?false:(s.add(a.key),true)); };
  ["base","impl","peer","cite","citedBy","mine"].forEach(k=>g[k]=dedupe(g[k]).sort((a,b)=>(b.w||0)-(a.w||0)));
  ["国","県","町"].forEach(k=>g.docs[k]=dedupe(g.docs[k]));
  return g;
}

function relGroup(title,arr,opts={}){
  if(!arr.length && !opts.always) return "";
  const lim=opts.limit||12;
  const items=arr.map((a,n)=>`<a class="rel-item${n>=lim?" x":""}" href="${esc(hrefOfKey(a.key))}">
      ${levelBadge(levelOfKey(a.key))}${clsBadge(clsOfKey(a.key))}<span class="rt">${esc(titleOfKey(a.key))}</span>
      <span class="rn">${esc(a.note||"")}</span>${a.user&&a.n!=null?`<button class="rm" data-rmlink="${a.n}" title="この関連づけを削除">✕</button>`:""}</a>`).join("");
  const more = arr.length>lim?`<button class="togg togg-close" data-togg>▾ 残り ${arr.length-lim} 件を表示</button><button class="togg togg-open" data-togg>▴ 折りたたむ</button>`:"";
  return `<div class="rel-group${arr.length>lim?" more":""}"><div class="sec-h">${title} <span class="n">${arr.length}件</span></div>${items||`<div class="empty">${opts.empty||"（登録なし）"}</div>`}${more}</div>`;
}

/* 関係マップ（SVG） */
function relMap(key,g){
  const pick=(arr,n)=>arr.slice(0,n).map(a=>a.key);
  const cols = {
    left: pick(g.base,5), right: pick(g.impl,5), top: pick(g.cite.concat(g.citedBy,g.peer),3),
    bottom: [...pick(g.docs.国,2),...pick(g.docs.県,1),...pick(g.docs.町,2)]
  };
  const W=860,H=470,cx=W/2,cy=H/2, nw=156, nh=34;
  const col=lv=>({国:"#1d3b69",県:"#2f5d46",町:"#8b1e2d"}[lv]);
  const trunc=(s,n)=>s.length>n?s.slice(0,n-1)+"…":s;
  const ct=titleOfKey(key); const shortT=k=>{const t=titleOfKey(k); return (k!==key&&t.length>ct.length&&t.startsWith(ct))?"〜"+t.slice(ct.length):t;};
  let svg="",lines="";
  const place=(keys,xf,yf,groupColor)=>keys.forEach((k,n,ar)=>{
    const x=xf(n,ar.length),y=yf(n,ar.length);
    const lv=levelOfKey(k);
    lines+=`<path d="M${cx} ${cy} Q${(cx+x)/2} ${(cy+y)/2 + (y<cy?-20:20)} ${x} ${y}" fill="none" stroke="${groupColor}" stroke-opacity=".5" stroke-width="1.4"/>`;
    svg+=`<a href="${esc(hrefOfKey(k))}" class="nd"><g><rect x="${x-nw/2}" y="${y-nh/2}" width="${nw}" height="${nh}" rx="2" fill="var(--card)" stroke="${col(lv)}" stroke-width="1.4"/>
      <text x="${x}" y="${y+5}" text-anchor="middle" font-size="12.5" fill="var(--ink)">${esc(trunc(shortT(k),11))}</text><title>${esc(titleOfKey(k))}</title></g></a>`;
  });
