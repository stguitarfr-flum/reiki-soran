    return `<div class="log-block"><h4><span>${esc(lg.date)}</span><span>改正 ${lg.counts[1]}件</span><span>新規 ${lg.counts[0]}件</span><span>廃止 ${lg.counts[2]}件</span>${wc?`<span class="badge b-warn">登録関連 ${wc}件</span>`:""}</h4>
      ${lg.note?`<div class="empty">${esc(lg.note)}（この回は差分比較の基準です。次回の更新から変更点が表示されます）</div>`:""}
      ${li?`<ul>${li}${ch.length>80?`<li class="empty">…ほか ${ch.length-80} 件</li>`:""}</ul>`:""}
      ${lg.added.length?`<div class="sec-h" style="margin:6px 16px">新規制定</div><ul>${lg.added.slice(0,40).map(a=>`<li><a href="#/law/${esc(a[0])}">${esc(a[1])}</a> <span style="color:var(--muted);font-size:13px">${esc(a[2])}</span></li>`).join("")}</ul>`:""}
      ${lg.local?localBlock(lg.local):""}
      ${lg.removed.length?`<div class="sec-h" style="margin:6px 16px">廃止・索引から消えた法令</div><ul>${lg.removed.slice(0,40).map(a=>`<li>${esc(a[1])}</li>`).join("")}</ul>`:""}</div>`;
  }).join("");
  $("#main").innerHTML=`<div class="dhead"><div class="eyebrow"><span class="badge b-kind">月次確認</span></div><h2>更新情報・法改正チェック</h2></div>
  <div class="pane">
    <div class="kpis">
      <div class="kpi"><b>${(META.lawCount||L.length).toLocaleString()}</b><span>収録法令</span></div>
      <div class="kpi"><b>${META.docCount||CUR.docs.length}</b><span>指針・例規等</span></div>
      <div class="kpi"><b>${META.textCount||0}</b><span>条文収録</span></div>
      <div class="kpi"><b>${days>=9999?"—":days}</b><span>最終確認からの日数</span></div>
    </div>
    <p>最終確認：<b>${esc(META.lastChecked||"—")}</b>（データ生成 ${esc(META.builtAt||"—")}／出典：${esc(META.source||"")}）</p>
    ${days>31?`<div class="note" style="border-color:var(--crimson)"><b>月次確認の時期です。</b> インターネットに接続した状態で <code>reiki_system\\monthly_update.bat</code> を実行してください。</div>`:""}
    <div class="sec-h">改正の履歴 <span class="n">「要確認」＝タグ付き・指針等に関連づけた法令に該当</span></div>
    ${blocks||'<div class="empty">履歴がありません</div>'}
    <div class="sec-h">月次更新の手順</div>
    <ol>
      <li>ネットに接続し <code>monthly_update.bat</code> をダブルクリック（e-Govから最新データを取得 → 差分を検出 → 本画面を更新）。</li>
      <li>本画面で「要確認」の法令を開き、関連づけた指針・通達・県／町の例規に影響がないか点検。</li>
      <li>指針・通達・例規側の改正は <code>data/curated.json</code> または「マイ登録」で更新（これらは自動取得できません）。</li>
